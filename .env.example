"""
Environment variables template for NYC Taxi application.

Copy this file to .env and fill in your specific values.
Never commit .env to version control.
"""

# ==========================================
# APPLICATION SETTINGS
# ==========================================
ENVIRONMENT=development
DEBUG=False

# ==========================================
# API SETTINGS
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
API_RELOAD=False
API_WORKERS=4

# ==========================================
# STREAMLIT SETTINGS
# ==========================================
STREAMLIT_API_URL=http://localhost:8000
STREAMLIT_TIMEOUT=30

# ==========================================
# DATABASE SETTINGS
# ==========================================
DB_PATH=data/artifacts/predictions.db
DB_POOL_SIZE=5
DB_TIMEOUT=5.0

# ==========================================
# MODEL SETTINGS
# ==========================================
MODEL_REPO=parthsavaliya001/nyc-taxi-trip-duration-model
MODEL_FILENAME=taxi_full_pipeline.pkl
MODEL_VERSION=1.0.0

# ==========================================
# LOGGING SETTINGS
# ==========================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ==========================================
# FEATURE ENGINEERING SETTINGS
# ==========================================
N_CLUSTERS=30
RANDOM_STATE=42

# ==========================================
# PRODUCTION SETTINGS (uncomment for production)
# ==========================================
# ENVIRONMENT=production
# DEBUG=False
# API_DEBUG=False
# API_RELOAD=False
# API_WORKERS=8
# LOG_LEVEL=WARNING
